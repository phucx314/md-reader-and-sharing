{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MDReader",
  "version": "0.1.0",
  "identifier": "com.phucx314.mdreader",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MD Reader",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: https: http:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost https://md-reader-and-sharing-be.onrender.com; font-src 'self' data: https:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Brutalist markdown reader",
    "longDescription": "A minimal, brutalist markdown reader/editor for Linux with Open With integration.",
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
